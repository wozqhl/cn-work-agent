    {
      "name": "postWebhookFeishu",
      "description": "Feishu webhook (URL verification + messages)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "X-Request-Id": {
            "type": "string",
            "maxLength": 128,
            "example": "mvp-appr-rid-a1b2"
          },
          "X-Lark-Request-Timestamp": {
            "type": "string"
          },
          "X-Lark-Request-Nonce": {
            "type": "string"
          },
          "X-Lark-Signature": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "example": "url_verification"
          },
          "challenge": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "text": {
            "description": "Message text (string or nested)",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ]
          }
        }
      }
    },
    {
      "name": "postWebhookDingtalk",
