    {
      "name": "getApproval",
      "description": "Get one approval",
      "inputSchema": {
        "type": "object",
        "properties": {
          "X-Request-Id": {
            "type": "string",
            "maxLength": 128,
            "example": "mvp-appr-rid-a1b2"
          },
