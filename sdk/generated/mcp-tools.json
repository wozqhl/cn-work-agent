            "type": "string"
          },
          "X-DingTalk-Sign": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "text": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    },
