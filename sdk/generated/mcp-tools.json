    {
      "name": "listApprovals",
      "description": "List approvals",
      "inputSchema": {
        "type": "object",
        "properties": {
          "X-Request-Id": {
            "type": "string",
            "maxLength": 128,
            "example": "mvp-appr-rid-a1b2"
          },
          "format": {
            "type": "string",
            "enum": [
              "json",
              "csv",
              "md",
              "html"
            ],
            "default": "json",
            "example": "csv"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "expired"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 0,
            "default": 50
          }
        }
      }
    },
