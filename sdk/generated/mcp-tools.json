    {
      "name": "getApprovalCard",
      "description": "IM card payload for an approval",
      "inputSchema": {
        "type": "object",
        "properties": {
          "X-Request-Id": {
            "type": "string",
            "maxLength": 128,
            "example": "mvp-appr-rid-a1b2"
          },
          "id": {
            "type": "string",
            "example": "appr_1a2b3c4d5e6f"
          },
          "platform": {
            "type": "string",
            "enum": [
              "feishu",
              "dingtalk",
              "wecom"
            ],
            "example": "feishu"
          }
        },
        "required": [
          "id"
        ]
      }
