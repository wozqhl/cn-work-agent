        ]
      }
    },
    {
      "name": "decideApprovalGet",
      "description": "Approve or reject (unsigned GET, demo IM cards)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "X-Request-Id": {
            "type": "string",
            "maxLength": 128,
            "example": "mvp-appr-rid-a1b2"
          },
          "id": {
            "type": "string",
            "example": "appr_1a2b3c4d5e6f"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "decision"
        ]
      }
    },
    {
      "name": "decideApproval",
      "description": "Approve or reject",
      "inputSchema": {
        "type": "object",
        "properties": {
          "X-Request-Id": {
            "type": "string",
            "maxLength": 128,
            "example": "mvp-appr-rid-a1b2"
          },
          "id": {
            "type": "string",
            "example": "appr_1a2b3c4d5e6f"
          },
          "X-Callback-Signature": {
            "type": "string",
            "example": "sha256=0123456789abcdef"
          },
          "X-Callback-Timestamp": {
            "type": "string",
            "example": "1710000000"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ]
          },
          "note": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "id",
          "decision"
        ]
      }
    }
